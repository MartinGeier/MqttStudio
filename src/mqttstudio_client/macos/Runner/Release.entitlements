<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- No App Sandbox: the headless CLI reads and writes the paths it is given, and projects keep the paths of their
     certificate files. The app is distributed outside the Mac App Store, signed with a Developer ID and notarized. -->
<dict>
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
